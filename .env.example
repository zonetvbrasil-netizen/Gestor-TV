# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (PostgreSQL, Auth e Row Level Security)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Provedor Pix Plugável: 'mock' | 'mercadopago' | 'asaas'
VITE_PIX_PROVIDER="mock"
MERCADOPAGO_ACCESS_TOKEN="TEST-1234567890"
ASAAS_API_KEY="$aact_YTU5YTE0M2M6N2NmNi00N2..."

# Integração WhatsApp Business Platform API (Opcional)
WHATSAPP_API_TOKEN="EAAX..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
